# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
APP_NAME=KnowAnswer
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/knowanswer.db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Milvus
# ---------------------------------------------------------------------------
MILVUS_URI=http://106.55.165.169:19530
MILVUS_TOKEN=
# 混合检索需要 collection 在创建时带 BM25 内置函数；
# 旧的 knowanswer_chunks 没有该 schema，请使用新 collection。
MILVUS_COLLECTION=knowanswer_chunks_v2

# ---------------------------------------------------------------------------
# Embedding（本地 bge，512 维）
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_FOLDER=D:\work_store\huggingface
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=512
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=

# ---------------------------------------------------------------------------
# 对话模型（DeepSeek）
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-flash
DEEPSEEK_BASE_URL=
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# 切分与检索
# ---------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# 父子切片（父块只存 SQLite，子块进 Milvus）
PARENT_CHILD_ENABLED=true
PARENT_CHUNK_SIZE=1024
PARENT_CHUNK_OVERLAP=128
RAG_PARENT_MAX_CHARS=1600

# 混合检索（稠密向量 + Milvus 内置 BM25，RRF 融合）
HYBRID_RETRIEVAL_ENABLED=true
RAG_RRF_K=60
RAG_SPARSE_ANALYZER=chinese
RAG_HYBRID_MIN_SCORE=0.0
RAG_CHILD_TOP_K_MULTIPLIER=3

RAG_TOP_K=6
# 仅在 dense 模式生效；混合模式请用 RAG_HYBRID_MIN_SCORE
RAG_MIN_SCORE=0.0
RAG_CHUNK_MAX_CHARS=1200
RAG_CONTEXT_MAX_CHARS=8000

# ---------------------------------------------------------------------------
# 会话记忆
# ---------------------------------------------------------------------------
MEMORY_MAX_MESSAGES=10
MEMORY_MAX_CHARS=4000
